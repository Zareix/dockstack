{
  "name": "dockstack",
  "version": "0.20.1",
  "private": true,
  "workspaces": [
    "wiki"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run --bun vite dev --port 3000",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "bun run format && bun run lint:fix",
    "db:generate": "bunx drizzle-kit generate",
    "auth:generate": "bunx --bun @better-auth/cli generate --config src/lib/auth/index.ts --output src/db/schema/auth-schema.ts",
    "wiki:dev": "bun run --filter wiki dev",
    "wiki:build": "bun run --filter wiki build",
    "openapi:generate": "bun run scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth-ui/core": "^1.6.43",
    "@better-auth-ui/react": "^1.6.45",
    "@better-auth/api-key": "^1.6.27",
    "@better-auth/passkey": "^1.6.27",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@phosphor-icons/react": "^2.1.10",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.101.4",
    "@tanstack/react-devtools": "0.10.10",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "^0.23.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.44",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.168.30",
    "@types/dockerode-compose": "^1.4.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "base-ui": "^0.0.294",
    "better-auth": "^1.6.27",
    "bowser": "^2.14.1",
    "bunqueue": "^2.8.59",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cnfast": "^0.1.0",
    "crossws": "^0.4.10",
    "date-fns": "^4.3.0",
    "dockerode": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "monaco-editor": "^0.54.0",
    "monaco-yaml": "^5.5.0",
    "next-themes": "^0.4.6",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "0.8.3",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.14",
    "@types/dockerode": "^4.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
