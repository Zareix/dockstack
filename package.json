{
  "name": "dockstack",
  "private": true,
  "workspaces": [
    "web",
    "wiki"
  ],
  "scripts": {
    "web:dev": "bun run --filter web dev",
    "web:api-gen": "bun run --filter web api:generate",
    "web:build": "bun run --filter web build",
    "web:format": "bun run --filter web format",
    "web:lint": "bun run --filter web lint:fix",
    "wiki:dev": "bun run --filter wiki dev",
    "wiki:build": "bun run --filter wiki build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
